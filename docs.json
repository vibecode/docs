{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Vibecode Docs",
  "colors": {
    "primary": "#FF8A3D",
    "light": "#FFB366",
    "dark": "#E67E2D"
  },
  "favicon": "/favicon.ico",
